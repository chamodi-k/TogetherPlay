# TogetherPlay Server Configuration Example
PORT=5000
NODE_ENV=development
# Comma-separated frontend origins. Add the deployed Netlify URL in Render.
CLIENT_URL=http://localhost:5173,https://your-site.netlify.app
JWT_SECRET=replace_with_a_secure_jwt_secret

# Database Configuration: 'sqlite' or 'oracle'
DB_TYPE=sqlite

# Oracle Database Credentials
ORACLE_USER=your_oracle_user
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECT_STRING=localhost:1521/XEPDB1
